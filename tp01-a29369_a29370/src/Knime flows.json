        "format": "<div style=\"font-family: sans-serif; padding: 10px;\">\n    <h3 style=\"color: #2196F3; border-bottom: 1px solid #ccc;\">Resumo do Torneio</h3>\n    <table style=\"width:100%; text-align:left; border-collapse: collapse;\">\n        <tr style=\"background-color: #f2f2f2;\">\n            <th style=\"padding: 8px;\">Equipa</th>\n            <th style=\"padding: 8px;\">Kills</th>\n            <th style=\"padding: 8px;\">Deaths</th>\n            <th style=\"padding: 8px;\">K/D Ratio</th>\n        </tr>\n        <tr ng-repeat=\"item in msg.payload\">\n            <td style=\"padding: 8px;\"><b>{{item.Team}}</b></td>\n            <td style=\"padding: 8px;\">{{item['Sum(Kills)']}}</td>\n            <td style=\"padding: 8px;\">{{item['Sum(Deaths)']}}</td>\n            <td style=\"padding: 8px; color: green;\"><b>{{item['K/D Ratio'] | number:2}}</b></td>\n        </tr>\n    </table>\n</div>",
